# ─────────────────────────────────────────────────────────────
# Pixel Perfect Films Institute — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local`.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Pixel Perfect Films Institute"

# Database (MongoDB Atlas)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>/ppfi?retryWrites=true&w=majority"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-strong-secret"

# Cloudinary (media uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Razorpay (payments)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Resend (transactional email)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="PPFI <noreply@pixelperfectfilms.in>"

# Admin bootstrap (used by the seed script)
ADMIN_EMAIL="admin@pixelperfectfilms.in"
ADMIN_PASSWORD="change-me-strong-password"
